# =============================================================================
# Nocturne - Spotify Integration Environment Configuration
# =============================================================================
# Spotify OAuth 2.0 PKCE Flow (Client-side, secure, no client secret required)
# Register an app at https://developer.spotify.com/dashboard
# Add Redirect URI: http://127.0.0.1:5173/callback
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# Optional Backend OAuth Credentials (if exchanging tokens via backend proxy)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
